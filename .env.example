# ============================================================================
# Quant Engine V2 — variables de entorno (plantilla)
# Copiar a `.env` y completar los secretos. `.env` NUNCA se commitea.
# Convención: prefijo QE_ + sección anidada con doble guion bajo (__).
# ============================================================================

# --- Aplicación ---
QE_ENVIRONMENT=development            # development | testing | paper | production

# --- Discord (único medio de notificación del sistema) ---
QE_DISCORD__ENABLED=true
QE_DISCORD__WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
QE_DISCORD__MIN_LEVEL=info            # info | success | warning | error | critical
# Canales lógicos con webhooks propios (Fase 9). Lo no mapeado usa el webhook
# por defecto de arriba. Canales: sistema|trading|errores|backtesting|ml|produccion|reportes
# QE_DISCORD__CHANNELS={"errores":"https://discord.com/api/webhooks/AAA/BBB","reportes":"https://discord.com/api/webhooks/CCC/DDD"}
# Ruteo fuente→canal (override del ruteo por defecto):
# QE_DISCORD__ROUTING={"kill_switch":"produccion"}

# --- Base de datos (PostgreSQL) ---
QE_DATABASE__HOST=localhost
QE_DATABASE__PORT=5432
QE_DATABASE__USER=quant
QE_DATABASE__PASSWORD=CHANGE_ME
QE_DATABASE__NAME=quant_engine

# --- Cache (Redis) ---
QE_CACHE__HOST=localhost
QE_CACHE__PORT=6379
QE_CACHE__PASSWORD=
QE_CACHE__DB=0

# --- Dashboard / API ---
QE_DASHBOARD__API_HOST=0.0.0.0
QE_DASHBOARD__API_PORT=8000

# --- Data Engine (Fase 2) ---
QE_MARKET__ENABLED=true
QE_MARKET__DEFAULT_PROVIDER=binance
# Listas/dicts anidados usan JSON:
QE_MARKET__SYMBOLS=["BTCUSDT","ETHUSDT"]
QE_MARKET__CHANNELS=["ticker","trades"]
QE_MARKET__TIMEFRAMES=["1m","5m"]
# Ruteo símbolo→proveedor (lo no listado usa default_provider):
# QE_MARKET__SYMBOL_PROVIDER={"XAUUSD":"mt5"}
# Overrides por proveedor (URLs de testnet, credenciales para fases futuras):
# QE_MARKET__PROVIDERS={"binance":{"enabled":true}}
QE_MARKET__STORAGE__ENABLED=true

# --- Broker de ejecución ---
# Vacío = paper puro. 'mt5_exness' = adaptador MetaTrader 5 hacia una cuenta DEMO.
QE_BROKER__NAME=
QE_BROKER__API_KEY=
QE_BROKER__API_SECRET=
# --- MetaTrader 5 (cuenta DEMO Exness) — sólo se usa si QE_EXECUTION__MODE=demo ---
# Requiere el terminal MT5 instalado y logueado en la demo, y 'pip install MetaTrader5'.
QE_BROKER__MT5__LOGIN=0                 # login de la cuenta demo (número)
QE_BROKER__MT5__PASSWORD=               # contraseña de la demo (SECRETO)
QE_BROKER__MT5__SERVER=                 # p. ej. Exness-MT5Trial8
QE_BROKER__MT5__TERMINAL_PATH=          # ruta a terminal64.exe (vacío = autodetección)
QE_BROKER__MT5__DEVIATION_POINTS=20     # desviación de precio tolerada en market orders
QE_BROKER__MT5__MAGIC=777001            # etiqueta de las órdenes del motor
QE_BROKER__MT5__TICK_POLL_SECONDS=0.5   # cadencia del feed de ticks MT5

# --- Notion (Fase 9 — documentación automática con cola de sincronización) ---
QE_NOTION__ENABLED=false
QE_NOTION__API_KEY=                    # token de integración (secret_...)
QE_NOTION__DATABASE_ID=               # la base debe tener una propiedad de título "Name"
# QE_NOTION__VERSION=2022-06-28

# --- Logging ---
QE_LOGGING__LEVEL=INFO
QE_LOGGING__JSON_FORMAT=false

# --- Quant Core (Fase 3) ---
QE_QUANT__ENABLED=true
# Método de consenso: majority_voting | weighted_voting | weighted_average
#                     | dynamic_weighting | regime_weighting
QE_QUANT__CONSENSUS__METHOD=weighted_average
QE_QUANT__CONSENSUS__MIN_SCORE=60
QE_QUANT__CONSENSUS__MIN_CONFIDENCE=0.5
# Config por estrategia (JSON): {"nombre":{"enabled":true,"weight":1.5,"parameters":{}}}
# QE_QUANT__STRATEGIES={}

# --- Execution Engine (Fase 5) — SOLO paper trading, live prohibido ---
QE_EXECUTION__ENABLED=false
QE_EXECUTION__MODE=paper              # 'paper' | 'demo' (MT5 cuenta demo) | 'live' (prohibido→paper)
# Balance semilla. En 'demo' con USE_BROKER_BALANCE=true se IGNORA y se usa el
# balance REAL de la cuenta MT5 (recargable en Exness); sólo actúa como fallback
# si el terminal no responde. En 'paper' es el balance de partida.
QE_EXECUTION__INITIAL_BALANCE=10000
QE_EXECUTION__USE_BROKER_BALANCE=true # en demo, leer el balance real de la cuenta
QE_EXECUTION__MANAGE_INTERVAL_SECONDS=2
QE_EXECUTION__BREAK_EVEN_R=1.0
QE_EXECUTION__TRAILING_ATR_MULTIPLE=2.0
QE_EXECUTION__MAX_HOLDING_MINUTES=240
# Simulación realista (probabilidades [0-1]):
QE_EXECUTION__REJECT_PROBABILITY=0.0
QE_EXECUTION__PARTIAL_FILL_PROBABILITY=0.0
# Comisiones (por nocional en bps, override por símbolo en JSON):
QE_EXECUTION__COMMISSION__TAKER_BPS=2.0
QE_EXECUTION__COMMISSION__MAKER_BPS=1.0
# QE_EXECUTION__COMMISSION__PER_SYMBOL={"XAUUSD":{"taker_bps":3.0}}
# Slippage: none | fixed | dynamic
QE_EXECUTION__SLIPPAGE__MODEL=dynamic
QE_EXECUTION__SLIPPAGE__BASE_BPS=1.0
# Latencia simulada (ms) que deriva el precio de ejecución:
QE_EXECUTION__LATENCY__ENABLED=true
# Position sizing: fixed_amount | percent | atr | fixed_risk | dynamic_risk | kelly
QE_EXECUTION__SIZING__METHOD=fixed_risk
QE_EXECUTION__SIZING__RISK_PER_TRADE_PCT=0.5
QE_EXECUTION__SIZING__REWARD_RISK=1.5
# Risk Manager:
QE_EXECUTION__RISK__MAX_OPEN_POSITIONS=5
QE_EXECUTION__RISK__MAX_DAILY_LOSS_PCT=3.0
QE_EXECUTION__RISK__MAX_CONSECUTIVE_LOSSES=5
QE_EXECUTION__RISK__KILL_SWITCH_DRAWDOWN_PCT=20.0
QE_EXECUTION__RISK__CIRCUIT_BREAKER_LOSS_PCT=5.0

# --- Producción (Fase 9) — operación 24/7. Live SIGUE deshabilitado ---
QE_PRODUCTION__ENABLED=false
QE_PRODUCTION__ALLOW_LIVE=false        # llave maestra: en false el Live Gate no aprueba jamás
QE_PRODUCTION__OPERATOR=               # actor por defecto de las acciones auditadas
# Reportes operativos automáticos (hora/día) al canal 'reportes':
QE_PRODUCTION__REPORTING__ENABLED=true
# Backups automáticos con rotación/verificación:
QE_PRODUCTION__BACKUP__ENABLED=true
QE_PRODUCTION__BACKUP__RETENTION=14
# Mantenimiento, actualizaciones y mejora continua:
QE_PRODUCTION__MAINTENANCE__ENABLED=true
QE_PRODUCTION__UPDATES__ENABLED=true
QE_PRODUCTION__IMPROVEMENT__ENABLED=true
# Alta disponibilidad (requiere un fichero de arriendo compartido entre nodos):
QE_PRODUCTION__FAILOVER__ENABLED=false
# QE_PRODUCTION__FAILOVER__NODE_ID=nodo-a

# --- Seguridad (Fase 9) — rate limiting, cabeceras, rotación de secretos ---
QE_SECURITY__ENABLED=true
QE_SECURITY__RATE_LIMIT_ENABLED=true
QE_SECURITY__RATE_LIMIT_REQUESTS=120
QE_SECURITY__RATE_LIMIT_WINDOW_SECONDS=60
QE_SECURITY__SECRET_MAX_AGE_DAYS=90

# --- Quant Research Lab (Fase 10) — investiga, NO opera. Live sigue vetado ---
# Laboratorio independiente: descubre y valida estrategias sobre copias; la
# promoción final siempre exige aprobación humana. Off por defecto.
QE_RESEARCH__ENABLED=false
QE_RESEARCH__OBJECTIVE=sharpe           # métrica primaria para ordenar/comparar
QE_RESEARCH__PERSIST=true               # stores append-only a disco (data/research)
QE_RESEARCH__PROMOTION__REQUIRE_OPERATOR_APPROVAL=true  # fail-closed: nunca automático
QE_RESEARCH__SHADOW__MIN_SIGNALS=30     # señales por lado antes de concluir el Shadow Mode
QE_RESEARCH__SHADOW__SIGNIFICANCE=0.05  # p-valor para significancia estadística
