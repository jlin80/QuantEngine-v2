# ============================================================================
# Quant Engine V2 — variables de entorno (plantilla)
# Copiar a `.env` y completar los secretos. `.env` NUNCA se commitea.
# Convención: prefijo QE_ + sección anidada con doble guion bajo (__).
# ============================================================================

# --- Aplicación ---
QE_ENVIRONMENT=development            # development | testing | paper | production

# --- Discord (único medio de notificación del sistema) ---
QE_DISCORD__ENABLED=true
QE_DISCORD__WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
QE_DISCORD__MIN_LEVEL=info            # info | success | warning | error | critical
# Canales lógicos con webhooks propios (Fase 9). Lo no mapeado usa el webhook
# por defecto de arriba. Canales: sistema|trading|errores|backtesting|ml|produccion|reportes
# QE_DISCORD__CHANNELS={"errores":"https://discord.com/api/webhooks/AAA/BBB","reportes":"https://discord.com/api/webhooks/CCC/DDD"}
# Ruteo fuente→canal (override del ruteo por defecto):
# QE_DISCORD__ROUTING={"kill_switch":"produccion"}

# --- Base de datos (PostgreSQL) ---
QE_DATABASE__HOST=localhost
QE_DATABASE__PORT=5432
QE_DATABASE__USER=quant
QE_DATABASE__PASSWORD=CHANGE_ME
QE_DATABASE__NAME=quant_engine

# --- Cache (Redis) ---
QE_CACHE__HOST=localhost
QE_CACHE__PORT=6379
QE_CACHE__PASSWORD=
QE_CACHE__DB=0

# --- Dashboard / API ---
QE_DASHBOARD__API_HOST=0.0.0.0
QE_DASHBOARD__API_PORT=8000

# --- Data Engine (Fase 2) ---
QE_MARKET__ENABLED=true
QE_MARKET__DEFAULT_PROVIDER=binance
# Listas/dicts anidados usan JSON:
QE_MARKET__SYMBOLS=["BTCUSDT","ETHUSDT"]
QE_MARKET__CHANNELS=["ticker","trades"]
QE_MARKET__TIMEFRAMES=["1m","5m"]
# Ruteo símbolo→proveedor (lo no listado usa default_provider):
# QE_MARKET__SYMBOL_PROVIDER={"XAUUSD":"mt5"}
# Overrides por proveedor (URLs de testnet, credenciales para fases futuras):
# QE_MARKET__PROVIDERS={"binance":{"enabled":true}}
QE_MARKET__STORAGE__ENABLED=true

# --- Broker de ejecución ---
# Vacío = paper puro. 'mt5_exness' = adaptador MetaTrader 5 hacia una cuenta DEMO.
QE_BROKER__NAME=
QE_BROKER__API_KEY=
QE_BROKER__API_SECRET=
# --- MetaTrader 5 (cuenta DEMO Exness) — sólo se usa si QE_EXECUTION__MODE=demo ---
# Requiere el terminal MT5 instalado y logueado en la demo, y 'pip install MetaTrader5'.
QE_BROKER__MT5__LOGIN=0                 # login de la cuenta demo (número)
QE_BROKER__MT5__PASSWORD=               # contraseña de la demo (SECRETO)
QE_BROKER__MT5__SERVER=                 # p. ej. Exness-MT5Trial8
QE_BROKER__MT5__TERMINAL_PATH=          # ruta a terminal64.exe (vacío = autodetección)
QE_BROKER__MT5__DEVIATION_POINTS=20     # desviación de precio tolerada en market orders
QE_BROKER__MT5__MAGIC=777001            # etiqueta de las órdenes del motor
QE_BROKER__MT5__TICK_POLL_SECONDS=0.5   # cadencia del feed de ticks MT5

# --- Notion (Fase 9 — documentación automática con cola de sincronización) ---
QE_NOTION__ENABLED=false
QE_NOTION__API_KEY=                    # token de integración (secret_...)
QE_NOTION__DATABASE_ID=               # la base debe tener una propiedad de título "Name"
# QE_NOTION__VERSION=2022-06-28

# --- Logging ---
QE_LOGGING__LEVEL=INFO
QE_LOGGING__JSON_FORMAT=false

# --- Quant Core (Fase 3) ---
QE_QUANT__ENABLED=true
# Método de consenso: majority_voting | weighted_voting | weighted_average
#                     | dynamic_weighting | regime_weighting
QE_QUANT__CONSENSUS__METHOD=weighted_average
QE_QUANT__CONSENSUS__MIN_SCORE=60
QE_QUANT__CONSENSUS__MIN_CONFIDENCE=0.5
# Config por estrategia (JSON): {"nombre":{"enabled":true,"weight":1.5,"parameters":{}}}
# QE_QUANT__STRATEGIES={}

# --- Execution Engine (Fase 5) — SOLO paper trading, live prohibido ---
QE_EXECUTION__ENABLED=false
QE_EXECUTION__MODE=paper              # 'paper' | 'demo' (MT5 cuenta demo) | 'live' (prohibido→paper)
# Balance semilla. En 'demo' con USE_BROKER_BALANCE=true se IGNORA y se usa el
# balance REAL de la cuenta MT5 (recargable en Exness); sólo actúa como fallback
# si el terminal no responde. En 'paper' es el balance de partida.
QE_EXECUTION__INITIAL_BALANCE=10000
QE_EXECUTION__USE_BROKER_BALANCE=true # en demo, leer el balance real de la cuenta
QE_EXECUTION__MANAGE_INTERVAL_SECONDS=2
QE_EXECUTION__BREAK_EVEN_R=1.0
QE_EXECUTION__TRAILING_ATR_MULTIPLE=2.0
QE_EXECUTION__MAX_HOLDING_MINUTES=240
# Salida por cambio de régimen. El holding mínimo se resuelve en tres escalones:
# por estrategia -> por categoría -> global. Un valor global único cortaba a
# `order_block` (tesis de ~30 min) antes de tiempo y dejaba a `bos` (~2 min)
# sin salida útil. Los defaults del código ya traen la tabla completa; estas
# variables sólo hacen falta para sobreescribirla (JSON, claves en minúsculas).
QE_EXECUTION__REGIME_CHANGE_MIN_HOLDING_SECONDS=180
# QE_EXECUTION__REGIME_CHANGE_MIN_HOLDING_BY_STRATEGY={"order_block":1950,"bos":135}
# QE_EXECUTION__REGIME_CHANGE_MIN_HOLDING_BY_CATEGORY={"smc":900,"volatility":150}
# Toggle de operativa por estrategia (mismo estilo que SYMBOLS_ENABLED). Bloquea
# sólo la APERTURA: la estrategia sigue emitiendo señales y votando, así que su
# historial no se corta y se puede medir qué habría hecho. Nadie lo cambia
# automáticamente — los experimentos del Bloque 2 sólo avisan por Discord.
# QE_EXECUTION__STRATEGIES_ENABLED={"atr_expansion":false,"mean_reversion":false}
# Experimentos con fecha de corte sobre estrategias en observación:
QE_EXECUTION__EXPERIMENTS__ENABLED=true
# QE_EXECUTION__EXPERIMENTS__WATCHING=["atr_expansion","mean_reversion"]
QE_EXECUTION__EXPERIMENTS__DEADLINE_HOURS=72
QE_EXECUTION__EXPERIMENTS__MIN_TRADES=20
# Falsación automática del cambio de holding (Bloque 7.1): mide en su ventana si
# take_profit sube del 0%, regime_change baja del 80% y la duración mediana se
# acerca a la esperada por estrategia. Notifica el veredicto ACIERTE O FALLE.
QE_EXECUTION__FALSIFICATION__ENABLED=true
QE_EXECUTION__FALSIFICATION__WINDOW_HOURS=48
QE_EXECUTION__FALSIFICATION__MIN_TRADES=20
# Simulación realista (probabilidades [0-1]):
QE_EXECUTION__REJECT_PROBABILITY=0.0
QE_EXECUTION__PARTIAL_FILL_PROBABILITY=0.0
# Comisiones (por nocional en bps, override por símbolo en JSON):
QE_EXECUTION__COMMISSION__TAKER_BPS=2.0
QE_EXECUTION__COMMISSION__MAKER_BPS=1.0
# QE_EXECUTION__COMMISSION__PER_SYMBOL={"XAUUSD":{"taker_bps":3.0}}
# Slippage: none | fixed | dynamic
QE_EXECUTION__SLIPPAGE__MODEL=dynamic
QE_EXECUTION__SLIPPAGE__BASE_BPS=1.0
# Latencia simulada (ms) que deriva el precio de ejecución:
QE_EXECUTION__LATENCY__ENABLED=true
# Position sizing: fixed_amount | percent | atr | fixed_risk | dynamic_risk | kelly
QE_EXECUTION__SIZING__METHOD=fixed_risk
QE_EXECUTION__SIZING__RISK_PER_TRADE_PCT=0.5
QE_EXECUTION__SIZING__REWARD_RISK=1.5
# Overrides por símbolo (riesgo/notional), para instrumentos con contract_size
# grande (XAUUSD=100) cuyo lote mínimo no cabe en los globales que sí bastan
# para BTC/ETH/USTEC (contract_size=1). Ver docs/execution.md.
# QE_EXECUTION__SIZING__RISK_PER_TRADE_PCT_BY_SYMBOL={"XAUUSDM":2.0}
# QE_EXECUTION__SIZING__MAX_POSITION_PCT_BY_SYMBOL={"XAUUSDM":1100.0}
# Risk Manager:
QE_EXECUTION__RISK__MAX_OPEN_POSITIONS=5
QE_EXECUTION__RISK__MAX_DAILY_LOSS_PCT=3.0
QE_EXECUTION__RISK__MAX_CONSECUTIVE_LOSSES=5
QE_EXECUTION__RISK__KILL_SWITCH_DRAWDOWN_PCT=20.0
QE_EXECUTION__RISK__CIRCUIT_BREAKER_LOSS_PCT=5.0
# QE_EXECUTION__RISK__MAX_SYMBOL_EXPOSURE_PCT_BY_SYMBOL={"XAUUSDM":1100.0}
# QE_EXECUTION__RISK__MAX_CORRELATION_EXPOSURE_PCT_BY_SYMBOL={"XAUUSDM":1100.0}

# --- Meta Strategy Manager (Fase 7) — gobierna configuración, nunca opera ---
QE_ML__META__ENABLED=true
# Aplicar de verdad pesos/activación sobre el Strategy Engine. En false el
# aplicador AUDITA lo que habría hecho sin tocar nada (modo observación).
QE_ML__META__APPLY_GOVERNANCE=false   # arrancar en modo OBSERVACION
QE_ML__META__MIN_TRADES=20
QE_ML__META__DISABLE_AFTER_PERIODS=5
# Gate de vigencia del modelo (avisa una vez por situacion, no por vuelta):
QE_ML__EXECUTION_RULES_CHECK__ENABLED=true

# --- Vigilancia del pipeline: motor ciego / motor mudo ---
# Detectan que el motor dejo de operar SIN caerse. Nacen del incidente del
# 31/07: 4 dias descartando el 100% de los ticks sin que nada avisara.
QE_PIPELINE_WATCH__ENABLED=true
QE_PIPELINE_WATCH__CHECK_INTERVAL_SECONDS=300
QE_PIPELINE_WATCH__BLIND_DISCARD_RATIO=0.95
QE_PIPELINE_WATCH__SILENT_WINDOWS=6

# --- Producción (Fase 9) — operación 24/7. Live SIGUE deshabilitado ---
QE_PRODUCTION__ENABLED=false
QE_PRODUCTION__ALLOW_LIVE=false        # llave maestra: en false el Live Gate no aprueba jamás
QE_PRODUCTION__OPERATOR=               # actor por defecto de las acciones auditadas
# Reportes operativos automáticos (hora/día) al canal 'reportes':
QE_PRODUCTION__REPORTING__ENABLED=true
# Backups automáticos con rotación/verificación:
QE_PRODUCTION__BACKUP__ENABLED=true
QE_PRODUCTION__BACKUP__RETENTION=14
# Mantenimiento, actualizaciones y mejora continua:
QE_PRODUCTION__MAINTENANCE__ENABLED=true
QE_PRODUCTION__UPDATES__ENABLED=true
QE_PRODUCTION__IMPROVEMENT__ENABLED=true
# Alta disponibilidad (requiere un fichero de arriendo compartido entre nodos):
QE_PRODUCTION__FAILOVER__ENABLED=false
# QE_PRODUCTION__FAILOVER__NODE_ID=nodo-a

# --- Seguridad (Fase 9) — rate limiting, cabeceras, rotación de secretos ---
QE_SECURITY__ENABLED=true
QE_SECURITY__RATE_LIMIT_ENABLED=true
QE_SECURITY__RATE_LIMIT_REQUESTS=120
QE_SECURITY__RATE_LIMIT_WINDOW_SECONDS=60
QE_SECURITY__SECRET_MAX_AGE_DAYS=90

# --- Quant Research Lab (Fase 10) — investiga, NO opera. Live sigue vetado ---
# Laboratorio independiente: descubre y valida estrategias sobre copias; la
# promoción final siempre exige aprobación humana. Off por defecto.
QE_RESEARCH__ENABLED=false
QE_RESEARCH__OBJECTIVE=sharpe           # métrica primaria para ordenar/comparar
QE_RESEARCH__PERSIST=true               # stores append-only a disco (data/research)
QE_RESEARCH__PROMOTION__REQUIRE_OPERATOR_APPROVAL=true  # fail-closed: nunca automático
QE_RESEARCH__SHADOW__MIN_SIGNALS=30     # señales por lado antes de concluir el Shadow Mode
QE_RESEARCH__SHADOW__SIGNIFICANCE=0.05  # p-valor para significancia estadística

# --- Quant Research Lab (Fase 10) — investiga, nunca opera ---
QE_RESEARCH__ENABLED=false
# Ciclo autonomo: DESACTIVADO por defecto. Activarlo es una decision explicita
# tras leer la propuesta de presupuesto en docs/research.md.
QE_RESEARCH__AUTO_CYCLE=false
# Presupuesto de CPU (ventana de baja actividad, topes de trabajo, timeout duro):
QE_RESEARCH__BUDGET__ENABLED=true
QE_RESEARCH__BUDGET__WINDOW_START_HOUR_UTC=1
QE_RESEARCH__BUDGET__WINDOW_END_HOUR_UTC=5
QE_RESEARCH__BUDGET__MAX_SYMBOLS_PER_RUN=2
QE_RESEARCH__BUDGET__MAX_GENERATED_PER_RUN=12
QE_RESEARCH__BUDGET__RUN_TIMEOUT_SECONDS=900
QE_RESEARCH__BUDGET__MAX_WORKERS=2
QE_RESEARCH__BUDGET__SKIP_IF_CPU_PCT_ABOVE=70
QE_RESEARCH__BUDGET__SKIP_IF_POSITIONS_OPEN=true

# Rollback automatico del ciclo autonomo (Bloque 10). Al reves que el ciclo,
# viene ACTIVADO: una salvaguarda no deberia requerir que la enciendan. Si el
# motor operativo se degrada, `auto_cycle` se apaga solo y avisa por Discord.
# NO se rearma solo: reactivarlo es una decision humana tras mirar la causa.
QE_RESEARCH__ROLLBACK__ENABLED=true
QE_RESEARCH__ROLLBACK__MAX_CPU_PCT=85            # CPU sostenida, no un pico
QE_RESEARCH__ROLLBACK__CPU_BREACHES_BEFORE_ROLLBACK=3
QE_RESEARCH__ROLLBACK__MAX_MANAGE_LATENCY_RATIO=2.0  # vs su propia referencia
QE_RESEARCH__ROLLBACK__MIN_MANAGE_PASSES=30      # sin muestra no se juzga
QE_RESEARCH__ROLLBACK__MAX_CLOCK_SKEW_SECONDS=5

# --- Evaluacion continua: resultado virtual POR SENAL (Bloque 8) ---
# El snapshot de siempre guarda el agregado por estrategia, que no permite unir
# fila a fila con el Trade Journal. Este store append-only guarda la fila, y es
# lo que hace posible separar "la senal tenia edge" de "la ejecucion lo capturo".
QE_QUANT__EVALUATION__PERSIST_OUTCOMES=true
QE_QUANT__EVALUATION__OUTCOMES_FLUSH_SIZE=50     # escritura por lotes

# --- Clasificacion de volatilidad (ADR-098) ---
# Los umbrales anteriores (0.05 / 0.80) eran de otra escala temporal: en 1m el
# ATR% maximo observado es 0.261%, asi que HIGH=0.80 era inalcanzable y
# `volatility` llegaba constante a `normal` en el 100% de las operaciones.
# Estos salen de la distribucion real. OJO: la escala NO es comparable entre
# activos (oro ~0.038% vs ETH ~0.068% de mediana), por eso hay tabla por simbolo
# en `quant.context.atr_pct_{low,high}_by_symbol` (whitelist del Config Center).
QE_QUANT__CONTEXT__ATR_PCT_LOW=0.04
QE_QUANT__CONTEXT__ATR_PCT_HIGH=0.12

# --- Edge Research Engine (Bloque 1, ADR-100) ---
# Mide la SALUD del edge por estrategia sobre ventana rodante: el acumulado no
# olvida, y una estrategia muerta sigue presentando buen aspecto durante semanas.
# No opera, no desactiva nada y no puede habilitar live: produce evidencia.
QE_QUANT__EDGE_RESEARCH__ENABLED=true
QE_QUANT__EDGE_RESEARCH__CYCLE_INTERVAL_SECONDS=900
QE_QUANT__EDGE_RESEARCH__ROLLING_WINDOW=300      # resoluciones por estrategia
QE_QUANT__EDGE_RESEARCH__BLOCKS=6                # troceado para decay/estabilidad
QE_QUANT__EDGE_RESEARCH__MIN_SAMPLE=30           # por debajo: insufficient_data
QE_QUANT__EDGE_RESEARCH__DECAY_THRESHOLD=0.05    # R perdida por bloque
QE_QUANT__EDGE_RESEARCH__MIN_STABILITY=0.35
QE_QUANT__EDGE_RESEARCH__MIN_PERSISTENCE=0.5
QE_QUANT__EDGE_RESEARCH__DEGRADING_REASONS=2     # un solo motivo es ruido
QE_QUANT__EDGE_RESEARCH__FACTOR_FLOOR=0.5        # suelo del freno al peso
QE_QUANT__EDGE_RESEARCH__PERSIST_HISTORY=true

# --- Edge Attribution Engine (Bloque 2, ADR-101) ---
# Mide ASOCIACION historica por bucket, no causa: los factores estan
# correlacionados entre si y sus aportes no son aditivos. El informe reporta
# siempre su residuo y lleva el aviso en el propio JSON.
QE_QUANT__ATTRIBUTION__ENABLED=true
QE_QUANT__ATTRIBUTION__CYCLE_INTERVAL_SECONDS=900
QE_QUANT__ATTRIBUTION__MIN_SAMPLE=40            # join operacion<->foto de factores
QE_QUANT__ATTRIBUTION__MIN_BUCKET=8             # buckets pequenos = ruido con lift enorme
QE_QUANT__ATTRIBUTION__MAX_TRADES=5000
QE_QUANT__ATTRIBUTION__PERSIST_SNAPSHOTS=true
QE_QUANT__ATTRIBUTION__SNAPSHOTS_FLUSH_SIZE=25

# --- Microstructure Engine (Bloque 3, ADR-102) ---
# EXIGE libro de ordenes incremental. Con MT5 (broker de la demo) no hay libro:
# el motor reporta observable=false con su motivo y todas las metricas en null,
# y el filtro es fail-open (sin medicion, deja pasar).
QE_QUANT__MICROSTRUCTURE__ENABLED=true
QE_QUANT__MICROSTRUCTURE__WINDOW_SECONDS=60
QE_QUANT__MICROSTRUCTURE__MIN_UPDATES=20
QE_QUANT__MICROSTRUCTURE__DEPTH_LEVELS=5
QE_QUANT__MICROSTRUCTURE__IMPACT_NOTIONAL=10000   # vara de medir fija, no el sizing real
QE_QUANT__MICROSTRUCTURE__MAX_EXECUTION_PRESSURE=0.85

# --- Regime Forecast Engine (Bloque 4, ADR-103) ---
# Frecuencia condicional empirica + validacion con Brier contra el pronostico
# trivial. Skill negativo se publica: es la senal de que no vale para decidir.
QE_QUANT__REGIME_FORECAST__ENABLED=true
QE_QUANT__REGIME_FORECAST__HORIZON_BARS=20
QE_QUANT__REGIME_FORECAST__MIN_SAMPLE=50         # por debajo: observable=false
QE_QUANT__REGIME_FORECAST__CONFIDENCE_SAMPLE=500 # mide evidencia, NO acierto
QE_QUANT__REGIME_FORECAST__SMOOTHING=1.0         # Laplace: nada es imposible
QE_QUANT__REGIME_FORECAST__VALIDATION_WINDOW=2000

# --- Correlation Intelligence (Bloque 5, ADR-104) ---
# Mide sobre RENDIMIENTOS (dos precios que suben correlacionan aunque no tengan
# relacion). No hay test ADF: se reporta vida media del residuo, que es lo
# accionable. El filtro de correlacion suma esto a los grupos manuales.
QE_QUANT__CORRELATION__ENABLED=true
QE_QUANT__CORRELATION__CYCLE_INTERVAL_SECONDS=900
QE_QUANT__CORRELATION__WINDOW=500
QE_QUANT__CORRELATION__MIN_SAMPLE=100
QE_QUANT__CORRELATION__EWMA_HALFLIFE=50          # correlacion dinamica, sin borde duro
QE_QUANT__CORRELATION__MAX_LAG=10
QE_QUANT__CORRELATION__MIN_CORRELATION=0.7       # umbral del filtro (valor absoluto)
QE_QUANT__CORRELATION__MIN_LEAD_CORRELATION=0.3

# --- Execution Optimizer (Bloque 6, ADR-105) ---
# MISS_COST_BPS es el parametro que gobierna todo: cuanto cuesta NO entrar. Sin
# el, LIMIT gana siempre y el optimizador es una maquina de no operar. Es una
# POLITICA, no una medida.
QE_EXECUTION__OPTIMIZER__ENABLED=true
QE_EXECUTION__OPTIMIZER__MISS_COST_BPS=12
QE_EXECUTION__OPTIMIZER__LIMIT_FILL_BASE=0.55    # prior afirmado, no medido
QE_EXECUTION__OPTIMIZER__IOC_FILL_BASE=0.8
QE_EXECUTION__OPTIMIZER__IMBALANCE_COEFF=0.3     # solo si el libro es observable
QE_EXECUTION__OPTIMIZER__QUALITY_REFERENCE_BPS=20

# --- Position Quality Engine (Bloque 7, ADR-106) ---
# Puede VETAR operaciones. Fail-open por debajo de MIN_DIMENSIONS observables:
# no bloquea por ignorancia. Los suelos por dimension evitan que una liquidez
# pesima se esconda detras de un setup excelente.
QE_QUANT__POSITION_QUALITY__ENABLED=true
QE_QUANT__POSITION_QUALITY__MIN_SCORE=45
QE_QUANT__POSITION_QUALITY__MIN_DIMENSIONS=4
QE_QUANT__POSITION_QUALITY__BLOCK_ON_FLOOR_BREACH=true
QE_QUANT__POSITION_QUALITY__MAX_COST_BPS=30

# --- Portfolio Intelligence (Bloque 8, ADR-107) ---
# Mide PnL REALIZADO, no exposicion viva. Una contribucion alta puede ser racha:
# por eso cada una viaja con su muestra y su expectativa.
QE_PORTFOLIO__ENABLED=true
QE_PORTFOLIO__MIN_SAMPLE=50
QE_PORTFOLIO__MAX_TRADES=20000

# --- Cost Attribution Engine (Bloque 9, ADR-108) ---
# El coste "oculto" es un RESIDUO: si crece, hay costes que el sistema no mide.
# La latencia sale como no medida (el journal no la registra) en vez de
# estimarse, para no destruir esa senal.
QE_COSTS__ENABLED=true
QE_COSTS__MAX_TRADES=20000
QE_COSTS__HIDDEN_ALERT_RATIO=0.1

# --- Confidence Calibration Engine (Bloque 10, ADR-109) ---
# Mide si la confianza declarada se cumple (curva, ECE, Brier, sesgo) y propone
# una correccion ACOTADA. No se aplica sola: corregir en silencio la propia
# entrada haria imposible saber si el modelo mejoro.
QE_ML__CALIBRATION__ENABLED=true
QE_ML__CALIBRATION__WINDOW=5000
QE_ML__CALIBRATION__BINS=10
QE_ML__CALIBRATION__MIN_SAMPLE=100
QE_ML__CALIBRATION__MIN_BIN_SAMPLE=10
QE_ML__CALIBRATION__MIN_CORRECTION=0.7
QE_ML__CALIBRATION__MAX_CORRECTION=1.3

# --- Data Quality Engine (Bloque 11, ADR-110) ---
# Reduce EXPOSICION, nunca apaga (eso lo decide el kill switch). Las senales
# criticas degradan por si solas: con la media, un motor ciego quedaba escondido
# detras de siete senales sanas — el fallo del 04/08.
QE_DATA_QUALITY__ENABLED=true
QE_DATA_QUALITY__CYCLE_INTERVAL_SECONDS=60
QE_DATA_QUALITY__DEGRADED_SCORE=70
QE_DATA_QUALITY__RISK_FLOOR=0.3                  # el multiplicador nunca llega a 0
QE_DATA_QUALITY__SIGNAL_FLOOR=0.8
QE_DATA_QUALITY__MAX_CLOCK_SKEW_SECONDS=5
QE_DATA_QUALITY__MAX_EXCHANGE_LAG_MS=2000

# --- Meta Risk Engine (Bloque 12, ADR-111) ---
# El riesgo de la MAQUINA. Se compone con la calidad del dato por PRODUCTO: un
# feed mediocre en una maquina saturada es peor que cualquiera por separado.
QE_META_RISK__ENABLED=true
QE_META_RISK__DEGRADED_SCORE=70
QE_META_RISK__RISK_FLOOR=0.3
QE_META_RISK__MAX_CPU_PERCENT=90
QE_META_RISK__MAX_MEMORY_PERCENT=90
QE_META_RISK__COMFORT_FRACTION=0.5    # por debajo, el recurso esta sano del todo
QE_META_RISK__MAX_EVENT_LOOP_LAG_MS=250
QE_META_RISK__MAX_EVENT_BUS_QUEUE=10000

# --- Feature Importance Tracker (Bloque 13, ADR-112) ---
# Permutacion, NO SHAP (razonado en la ADR). La semilla es fija a proposito: sin
# ella, el "cambio" mediria el ruido del metodo en vez del del mercado.
QE_ML__IMPORTANCE__ENABLED=true
QE_ML__IMPORTANCE__REPEATS=5
QE_ML__IMPORTANCE__MIN_SAMPLE=50
QE_ML__IMPORTANCE__HISTORY_LIMIT=50
QE_ML__IMPORTANCE__SEED=20260805

# --- Why Not Trade Engine (Bloque 14, ADR-113) ---
# Registra cada decision con su desglose de umbrales y filtros. Las evaluaciones
# SIN SENAL se cuentan pero no se guardan: serian ~170.000 filas al dia de un
# motivo que no es un motivo.
QE_QUANT__REJECTIONS__ENABLED=true
QE_QUANT__REJECTIONS__PERSIST=true
QE_QUANT__REJECTIONS__FLUSH_SIZE=50
QE_QUANT__REJECTIONS__MEMORY_LIMIT=2000

# --- Live Shadow Benchmark (Bloque 15, ADR-114) ---
# LIVE SIGUE DESHABILITADO: este bloque no lo habilita ni lo prepara. Sin carril
# live, el gap medido es el slippage que el propio simulador modelo — es una
# LINEA BASE, no una medicion independiente.
QE_SHADOW_BENCHMARK__ENABLED=true
QE_SHADOW_BENCHMARK__MIN_SAMPLE=100     # por debajo: cero recomendaciones
QE_SHADOW_BENCHMARK__HIGH_GAP_BPS=15
QE_SHADOW_BENCHMARK__HIGH_EDGE_SHARE=0.3
