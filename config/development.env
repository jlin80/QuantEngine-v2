# Overrides no sensibles para el ambiente: development
QE_LOGGING__LEVEL=DEBUG
QE_LOGGING__JSON_FORMAT=false
QE_DASHBOARD__API_RELOAD=false
QE_HEALTH__CHECK_INTERVAL_SECONDS=30
QE_WATCHDOG__CHECK_INTERVAL_SECONDS=10
# Data Engine encendido en desarrollo (streams públicos, sin credenciales).
QE_MARKET__ENABLED=true
# Quant Core encendido en desarrollo (sin estrategias concretas todavia).
QE_QUANT__ENABLED=true
