# Overrides no sensibles para el ambiente: production (live trading — fase futura)
QE_LOGGING__LEVEL=INFO
QE_LOGGING__JSON_FORMAT=true
QE_HEALTH__CHECK_INTERVAL_SECONDS=15
QE_WATCHDOG__CHECK_INTERVAL_SECONDS=5
# El Data Engine siempre corre en producción.
QE_MARKET__ENABLED=true
QE_QUANT__ENABLED=true
