# Overrides no sensibles para el ambiente: testing
# Las notificaciones se desactivan SIEMPRE en testing para no golpear el webhook real.
QE_DISCORD__ENABLED=false
# El Data Engine se desactiva en testing: nada de red en los tests.
QE_MARKET__ENABLED=false
QE_LOGGING__LEVEL=WARNING
QE_LOGGING__JSON_FORMAT=false
QE_HEALTH__CHECK_INTERVAL_SECONDS=1
QE_WATCHDOG__CHECK_INTERVAL_SECONDS=1
# Quant Core apagado en testing (los tests construyen sus propias piezas).
QE_QUANT__ENABLED=false
